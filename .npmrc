# Resilient installs.
#
# vendor/npm-cache holds every tarball of package-lock.json, so `npm install`
# resolves from disk instead of registry.npmjs.org. `prefer-offline` (not a hard
# `offline`) keeps the network as a fallback for anything not vendored.
cache=vendor/npm-cache
prefer-offline=true
audit=false
fund=false
update-notifier=false

# Corporate proxies and antivirus filters often reset parallel TLS connections
# (ECONNRESET). One socket plus generous retries makes the fallback reliable.
maxsockets=1
fetch-retries=5
fetch-retry-mintimeout=20000
fetch-retry-maxtimeout=120000
fetch-timeout=600000
