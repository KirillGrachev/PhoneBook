{
  "name": "kmaruda-phonebook",
  "private": true,
  "version": "0.2.5",
  "type": "module",
  "description": "Корпоративный телефонный справочник КМАруда (Active Directory)",
  "author": "Kirill Grachev (https://github.com/KirillGrachev)",
  "license": "MIT",
  "scripts": {
    "dev": "vite --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "check:locales": "node scripts/check-locales.mjs",
    "check:version": "node scripts/check-version.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.mjs\" index.html vite.config.ts vitest.config.ts tsconfig.json tsconfig.node.json .prettierrc.json eslint.config.js package.json",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.mjs\" index.html vite.config.ts vitest.config.ts tsconfig.json tsconfig.node.json .prettierrc.json eslint.config.js package.json"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@tauri-apps/api": "^2.12.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^27.0.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-focus-lock": "^2.13.7",
    "react-i18next": "^17.0.7",
    "react-qr-code": "^2.2.0",
    "react-router-dom": "^7.18.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/react": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.12",
    "axe-core": "^4.14.0",
    "eslint": "^10.4.1",
    "globals": "^15.14.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "~5.8.2",
    "vite": "^8.3.7",
    "vitest": "^4.1.9",
    "vitest-axe": "^0.1.0"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "^11.0.1"
    },
    "eslint": {
      "minimatch": "^11.0.4"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.4"
    }
  }
}
